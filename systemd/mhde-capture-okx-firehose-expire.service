# /home/jpcg/.config/systemd/user/mhde-capture-okx-firehose-expire.service
[Unit]
Description=MHDE capture-okx WS firehose retention sweep (OKX root)
After=network-online.target

[Service]
# Daily oneshot for the OKX root: REUSES the shared capture_core firehose CLI
# verbatim via --root (the maintenance layer is venue-agnostic; the OKX WS
# collector writes the same firehose dataset names/schemas). Deletes raw
# aggTrade/bookTicker/markPrice/forceOrder partitions past the retention
# horizon; klines/as-of/_gaps are excluded in code. Filesystem-only.
#
# BUILT-NOT-DEPLOYED: tracked but not installed/enabled.
Type=oneshot
WorkingDirectory=/home/jpcg/MHDE
ExecStartPre=/usr/bin/test -x /home/jpcg/MHDE/venv/bin/python
ExecStart=/home/jpcg/MHDE/venv/bin/python main.py crypto capture-firehose-expire --root data/research/capture_core_okx --depth-days 1
Nice=19
IOSchedulingClass=idle
MemoryMax=256M
CPUWeight=20
IOWeight=20
OOMScoreAdjust=800
StandardOutput=journal
StandardError=journal
