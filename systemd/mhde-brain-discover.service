# /home/jpcg/.config/systemd/user/mhde-brain-discover.service
[Unit]
Description=MHDE brain discovery engine — batch rule discovery/scoring/confirmation (spec §9)
After=network-online.target

[Service]
# Heavy periodic BATCH (NOT the tick loop): refresh the engineered primitives, run Stage-1
# (generate -> score -> permutation null) on settled labels, advance rule states via forward
# confirmation, run Stage-2 exit discovery on entry survivors, and log simulated round trips.
# Writes ONLY the discovery SQLite-WAL DB (data/research/brain/discovery.sqlite); reads the
# brain store + registry READ-ONLY; never opens the production DuckDB or the engine DB. The permutation
# null is the dominant cost. OOM-first and idle-scheduled, so a discovery run never disturbs
# the engine's 1s cycle or capture/tick. Paired with the .timer.
#
# MemoryMax basis — FULL-PASS decomposition, measured on the real store 2026-08-11 at
# 9.12M instances in the 14+2d window (data/processed/stage1_breadth_cap_measurement.md §9):
#   engineered tape (columnar)            ~8.3G   (scales ~linearly with instance count)
#   price_index + coin_vols (held)        ~1.7G
#   label load, COLUMNAR (transient)      ~1.9G   (was ~3G as list-of-dicts — the measured
#                                                  2026-08-11 gate-OOM term, removed in PR#88)
#   beamed depth loop (BEAM_WIDTH=500)    <=0.5G  (measured across the designed-depth run)
#   => pass peak ~12G worst-case at current store size; 13G caps it with margin while the
#   co-tenants (capture fleet ~3.4G + brain-tick 3G + engine ~0.2G) leave ~14.5G host
#   headroom on the zero-swap 22G host (~2.5G host slack during a pass). The window is
#   BOUNDED (14+2d), so residency plateaus near window saturation; revisit only if the
#   per-day instance density grows the tape toward ~10G.
#
# DEPLOYED since 2026-08-13 (timer enabled, 6-hourly). This tracked copy is the source of
# truth; changes take effect only after the operator copies it to ~/.config/systemd/user/
# and daemon-reloads.
# PROTECTED WINDOW (2026-08-13): the pass runs ~4h at ~11.5G beside hourly compactors
# whose 1-2G bursts repeatedly host-OOM'd it (first scheduled run died 4 min after
# brain-compact fired). ExecStartPre pauses the three compactor TIMERS (in-flight compact
# SERVICES finish normally); ExecStopPost — which runs on EVERY exit, oom-kill included —
# restores them. A transient 5h30m failsafe covers exactly a failed/skipped ExecStopPost
# and no-ops if the pass is somehow still running (a mid-pass restart would recreate the
# collision). It does NOT survive a user-manager death — that case self-heals because the
# three timers are enabled and a fresh manager pulls them in via timers.target. Honest
# bound: removes the known hourly spikes, not the unidentified ambient burst class.
# See scripts/discovery_compact_window.sh for backlog math + catch-up concurrency.
Type=oneshot
WorkingDirectory=/home/jpcg/MHDE
ExecStartPre=/usr/bin/test -x /home/jpcg/MHDE/venv/bin/python
ExecStartPre=/bin/bash /home/jpcg/MHDE/scripts/discovery_compact_window.sh pause
ExecStart=/home/jpcg/MHDE/venv/bin/python main.py crypto brain-discover-run
ExecStopPost=/bin/bash /home/jpcg/MHDE/scripts/discovery_compact_window.sh resume
Nice=19
IOSchedulingClass=idle
MemoryMax=13G
CPUWeight=20
IOWeight=20
OOMScoreAdjust=800
StandardOutput=journal
StandardError=journal
