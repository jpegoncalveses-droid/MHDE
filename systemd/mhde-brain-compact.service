# /home/jpcg/.config/systemd/user/mhde-brain-compact.service
[Unit]
Description=MHDE brain-store compaction — sealed partitions + today's closed hours, registry-parity-checked
After=network-online.target

[Service]
# Hourly oneshot (drift Fix 2a): the brain tick loop writes ONE part file per (symbol,date)
# PER PASS (~844 files/tick), and the label pass reads them all back every 5th tick — an
# uncompacted store grew to 229k in-scope full reads per label pass in one 10.5h run (the
# 2026-07-02 drift). This unit merges sealed (date < today) partitions to ~1 file each, then
# today's CLOSED event-hours to ~1 file per hour, both subprocess-chunked and registry-
# parity-checked with the coverage guard hard-ON (a partition/hour the registry has never
# recorded is skipped + surfaced, never silently merged). Safe beside the RUNNING tick loop:
# merges are replace-then-delete and the brain store reader retries once on a vanished file.
# Writes only under data/research/brain; opens the registry read-only; never opens DuckDB,
# the engine DB, or the capture store.
#
# BUILT-NOT-DEPLOYED: tracked but not installed/enabled. Enabling is the operator's deploy.
Type=oneshot
WorkingDirectory=/home/jpcg/MHDE
ExecStartPre=/usr/bin/test -x /home/jpcg/MHDE/venv/bin/python
ExecStart=/home/jpcg/MHDE/venv/bin/python main.py crypto brain-compact
# Shared-host invariant (ADR-036/038): idle CPU+IO and OOM-first, so compaction never
# disturbs the engine's 1s cycle even though it reads+rewrites while the brain loop is live.
Nice=19
IOSchedulingClass=idle
# MemoryMax is the BACKSTOP, not the sizing mechanism (KI-165). The real bound is the
# subprocess partition-slice cap (BRAIN_COMPACT_PARTITIONS_PER_CHUNK): each chunk subprocess
# touches ≤1000 partitions then exits, returning its pyarrow pool + SQLite state to the OS.
# Measured working set is small — worker import ~106 MiB, and reading ~8k small part files is
# flat at ~75 MiB RSS (per-partition data is sub-MiB) — so steady state is <~250 MiB. Raised
# 1G→2G (~8× headroom over the measured working set) to absorb parent+subprocess coexistence
# and any SQLite/page-cache spike against the (oversized, pending-prune) 9.5 GiB registry,
# while staying well under the tick loop's 3G and leaving the engine host headroom. The old 1G
# was hit only because the pre-fix driver handed ONE subprocess the entire remaining partition
# tail — it OOM-looped hourly for ~4 days (the KI-165 incident). If 2G is ever hit again the
# compactor-freshness monitor now surfaces it within ~3 h instead of failing silently.
MemoryMax=2G
CPUWeight=20
IOWeight=20
OOMScoreAdjust=800
StandardOutput=journal
StandardError=journal
