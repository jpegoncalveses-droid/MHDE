# /home/jpcg/.config/systemd/user/mhde-capture-okx-klines-expire.service
[Unit]
Description=MHDE capture-okx klines retention — expire partitions past the window
After=network-online.target

[Service]
# Oneshot rolling-retention sweep for the OKX 1h klines store: REUSES the
# existing capture_core CLI verbatim via --root (same dataset name, same
# 90-day default window). Filesystem-only; never opens the production DB.
#
# BUILT-NOT-DEPLOYED: tracked but not installed/enabled.
Type=oneshot
WorkingDirectory=/home/jpcg/MHDE
ExecStartPre=/usr/bin/test -x /home/jpcg/MHDE/venv/bin/python
ExecStart=/home/jpcg/MHDE/venv/bin/python main.py crypto capture-klines-expire --root data/research/capture_core_okx
MemoryMax=256M
CPUWeight=20
IOWeight=20
OOMScoreAdjust=800
StandardOutput=journal
StandardError=journal
