# /home/jpcg/.config/systemd/user/mhde-brain-tick.service
[Unit]
Description=MHDE brain TICK loop — continuous primitives + forward-only labels substrate (Phase 1)
After=network-online.target mhde-capture.target
Wants=network-online.target
# A crash-LOOP trips to `failed` (alertable) rather than flapping forever.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
# CONTINUOUS long-running loop (one tick/minute): each tick computes per-(symbol,window)
# RAW primitives from the live capture tape past each source's cursor and writes them, and
# every 5th tick computes the forward-only MFE/MAE labels. Cold start FORWARD-SEEDS each
# source's cursor to now-watermark, so a first start reads only windows settling from now on
# (NO ~19GB/275K-file backlog replay). Writes ONLY data/research/brain (primitives + labels +
# registry); reads the capture tape READ-ONLY; never opens the production DuckDB or engine DB.
#
# Steady-state work is bounded (25-symbol batches per source per minute). MemoryMax=3G
# (drift Fix 4, was 2G): measured over the 2026-07-01/02 night at 2G, the cgroup hit its cap
# 316,958 times with 21.9M direct-reclaim scans and 9.87M file refaults (~37.6 GiB re-read
# from disk) — anon is only ~1.0G but the capture-tape + brain-store working set cannot stay
# page-cached beside it in 2G, so every tick re-read footers from disk. 3G lets the hot set
# actually cache while leaving the host ~4.9G available worst-case (15.6G total; capture
# ~2.7G live-critical aggregate, streamlit ~2G) — the HOST aggregate stays the binding
# limit. OOM-first (OOMScoreAdjust=800) + Restart=on-failure means an occasional OOM
# self-heals (cursor unmoved -> retried) and never disturbs the 1s engine cycle.
#
# IO (drift Fix 4): BEST-EFFORT at the LOWEST priority (7), no longer class-idle. Idle-class
# IO is starved indefinitely while ANY best-effort IO runs anywhere on the host — with 8
# capture shards writing continuously plus hourly compactors, the brain's reads queued
# behind everything (the measured live-vs-gate fast-tick gap), and each of the 37.6 GiB of
# refault re-reads paid that queue. BE-7 still yields to every higher-priority BE task (the
# engine and capture run at the BE default, 4) but is never starved outright; IOWeight=20
# keeps the cgroup-level ceiling, Nice=19 + CPUWeight=20 keep CPU deference unchanged (CPU
# was never the starved resource — ~1.1 cores used all night).
#
# BUILT-NOT-DEPLOYED: tracked but not installed/enabled. Enabling is the operator's deploy.
Type=simple
WorkingDirectory=/home/jpcg/MHDE
ExecStartPre=/usr/bin/test -x /home/jpcg/MHDE/venv/bin/python
ExecStart=/home/jpcg/MHDE/venv/bin/python -m crypto.research.brain.runner --tick-interval-s 60 --label-every-n-ticks 5
Restart=on-failure
RestartSec=10
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=3G
CPUWeight=20
IOWeight=20
OOMScoreAdjust=800
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
